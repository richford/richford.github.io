---
/**
 * Toggle bar shown above /resume/general and /cv.
 *
 * Two pill tabs ("Short Resume" and "Long CV") plus a "Print / Save PDF"
 * action on the right. Hidden in print via the `print-hide` class (handled
 * by resume-print.css).
 *
 * Usage:
 *   <ResumeCvToggle active="resume" /> ... or active="cv"
 */

interface Props {
  active: "resume" | "cv";
  /**
   * DOM id for the print button. Default "site-print-btn". The page is
   * responsible for wiring window.print() to it; that JS lives in the page
   * file so we don't ship duplicate listeners.
   */
  printButtonId?: string;
}

const { active, printButtonId = "site-print-btn" } = Astro.props;

const tabBase =
  "px-4 py-1.5 rounded-full text-sm font-medium transition-colors";
const tabActive = "bg-accent text-white";
const tabInactive = "text-slate-400 hover:text-slate-100";
---

<div
  class="print-hide flex flex-wrap items-center justify-between gap-3 mb-10"
>
  <div
    class="inline-flex items-center gap-1 p-1 rounded-full border border-slate-800 bg-slate-900/50"
    role="tablist"
    aria-label="Document view"
  >
    <a
      href="/resume/general"
      role="tab"
      aria-selected={active === "resume"}
      class:list={[tabBase, active === "resume" ? tabActive : tabInactive]}
    >
      Short Resume
    </a>
    <a
      href="/cv"
      role="tab"
      aria-selected={active === "cv"}
      class:list={[tabBase, active === "cv" ? tabActive : tabInactive]}
    >
      Long CV
    </a>
  </div>

  <button
    id={printButtonId}
    type="button"
    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-slate-100 text-sm font-medium transition-colors cursor-pointer"
  >
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="1.5"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m0 0a48.09 48.09 0 0 1 10.5 0m-10.5 0V5.625c0-.621.504-1.125 1.125-1.125h8.25c.621 0 1.125.504 1.125 1.125v2.034"
      ></path>
    </svg>
    Print / Save PDF
  </button>
</div>
